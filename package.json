    "db:generate": "drizzle-kit generate",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@x402/evm": "^2.17.0",
    "@x402/fetch": "^2.17.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.16",
    "viem": "2.52.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "4.20260613.1",
    "@jazzer.js/core": "^4.0.0",
    "drizzle-kit": "^0.30.0",
    "fast-check": "^4.8.0",
    "typescript": "^5.7.0",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "wrangler": "4.164.0"
  },
