      "postcss": "8.5.23",
      "sharp": "0.35.5",
      "shell-quote": "1.11.0",
      "source-map-js": "1.2.2",
      "tinypool": "2.1.2",
      "undici": "7.30.1",
      "vite": "6.4.5",
      "vitest": "4.1.12",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "zod": "4.6.7"
    }
  }
